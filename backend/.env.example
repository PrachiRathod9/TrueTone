# TrueTone Backend Environment Configuration
# Copy this file to backend/.env and replace placeholders with your actual settings.
# NEVER commit backend/.env to version control.

# Firebase Authentication (ID Token Verification)
FIREBASE_PROJECT_ID=truetone-4149b

# MySQL Database Configuration
# Leave MYSQL_PASSWORD empty or unconfigured to automatically use the transparent local JSON fallback
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=truetone_db

# Hugging Face Model Token (optional if model weights are already cached locally)
# HF_TOKEN=hf_yourHuggingFaceTokenHere
