# TrueTone Frontend & Client Environment Configuration
# Copy this file to .env and replace placeholder values with your real configuration.
# NEVER commit .env to version control.

# Firebase Project Configuration (from Firebase Console > Project Settings)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=truetone-4149b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=truetone-4149b
VITE_FIREBASE_STORAGE_BUCKET=truetone-4149b.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# TrueTone Backend API URL (for Android device/emulator or local dev)
# For physical phone on same Wi-Fi: http://<laptop-local-ip>:8000
# For Android emulator: http://10.0.2.2:8000
# For local web dev: http://127.0.0.1:8000
VITE_TRUETONE_API_URL=http://127.0.0.1:8000
